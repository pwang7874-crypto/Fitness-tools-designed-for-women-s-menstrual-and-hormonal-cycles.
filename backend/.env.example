ENV=dev
DEEPSEEK_API_KEY=请填入你的DeepSeekKey
MODEL_ID=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DATABASE_URL=sqlite:///./data/cyclefit.db
COOKIE_SECURE=false
INVITE_CODES=

# 生产轻量持久化：SQLite 快照定期备份到 TOS（S3 兼容接口）
DATABASE_BACKUP_ENABLED=false
DATABASE_BACKUP_INTERVAL_SECONDS=300
S3_ENDPOINT=https://tos-s3-cn-beijing.volces.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=cn-beijing
S3_DATABASE_KEY=cyclefit/database/cyclefit.db
